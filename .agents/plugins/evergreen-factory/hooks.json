{
  "evergreen-target-guardrail": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 skills/evergreen-platform/scripts/verify_targets_hook.py --pre-tool-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
